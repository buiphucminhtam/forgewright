# Production Grade Plugin Configuration
# Copy this file to .production-grade.yaml at project root and customize.
# The orchestrator reads this file to adapt paths and behavior to your project.

version: "3.0"

project:
  name: ""                          # Project name (auto-detected from git if empty)
  language: "typescript"             # typescript | go | python | rust | java
  framework: ""                     # nestjs | express | fastapi | gin | actix | spring
  cloud: ""                         # unset | aws | gcp | azure
  architecture: "modular-monolith" # monolith | modular-monolith | microservices

# Path mappings — customize to match your existing project structure.
# All paths are relative to the project root.
paths:
  api_contracts: "api/openapi/*.yaml"
  grpc_contracts: "api/grpc/*.proto"
  async_contracts: "api/asyncapi/*.yaml"
  architecture_docs: "docs/architecture/"
  adrs: "docs/architecture/architecture-decision-records/"
  tech_stack: "docs/architecture/tech-stack.md"
  system_diagrams: "docs/architecture/system-diagrams/"
  erd: "schemas/erd.md"
  migrations: "schemas/migrations/*.sql"
  services: "services/"
  shared_libs: "libs/shared/"
  frontend: "frontend/"
  tests: "tests/"
  terraform: "infrastructure/terraform/"
  kubernetes: "infrastructure/kubernetes/"
  monitoring: "infrastructure/monitoring/"
  ci_cd: "scripts/ci/"                # canonical local automation; hosted adapters are optional
  docs: "docs/"
  runbooks: "docs/runbooks/"
  workspace: "Claude-Production-Grade-Suite/"
  brd: "Claude-Production-Grade-Suite/product-manager/BRD/"

# Preferences — override defaults for tools and frameworks.
preferences:
  test_framework: "jest"             # jest | vitest | pytest | go-test | junit
  orm: "prisma"                      # prisma | drizzle | typeorm | sqlalchemy | gorm
  ci_provider: "local"               # local default; hosted providers require explicit opt-in
  package_manager: "npm"             # npm | pnpm | yarn | bun
  linter: "eslint"                   # eslint | biome | ruff | golangci-lint
  formatter: "prettier"              # prettier | biome | black | gofmt
  frontend_framework: "nextjs"       # nextjs | nuxt | sveltekit | remix
  state_management: "react-query"    # react-query | redux | pinia | svelte-stores
  styling: "tailwind"                # tailwind | css-modules | styled-components | vanilla-extract

# Feature toggles — enable/disable pipeline phases and features.
features:
  frontend: true                     # Set false for API-only projects
  ai_ml: false                       # Auto-detected from imports if false
  multi_tenancy: false               # Enable only from an accepted tenancy requirement
  documentation_site: false          # Enable only when a separate docs site is required
  payment_integration: false         # Include Stripe/payment service
  real_time: false                   # WebSocket/SSE support
  graphql: false                     # GraphQL API alongside REST
  grpc: false                        # gRPC inter-service communication
  event_driven: false                # Enable only from measured async/scale needs

# Phase control — skip or customize pipeline phases.
phases:
  define: true
  build: true
  harden: true
  ship: true
  sustain: true
  # Set false to skip individual skills within phases:
  # data_scientist: false
  # skill_maker: false

# Native Codex subagent routing. Unsupported preferences are omitted instead
# of being silently substituted.
subagents:
  codex:
    # Owner-approved 2026-11-28: Luna handles bounded inventory, Terra handles
    # exploration, Sol implements, and Astra plans and reviews.
    default:
      model: "gpt-6.2-sol"
      reasoning_effort: "medium"
    tiers:
      scout: { model: "gpt-6-luna", reasoning_effort: "low" }
      builder: { model: "gpt-6.2-sol", reasoning_effort: "medium" }
      expert: { model: "gpt-6.2-sol", reasoning_effort: "high" }
      planner: { model: "gpt-6.2-astra", reasoning_effort: "high" }
      reviewer: { model: "gpt-6.2-astra", reasoning_effort: "high" }
    agent_types:
      explorer: { model: "gpt-6.1-terra", reasoning_effort: "low" }
      worker: { model: "gpt-6.2-sol", reasoning_effort: "medium" }
  claude:
    # Claude Code Agent tool: tier -> plugin agent (model and effort pinned in
    # agents/*.md frontmatter) plus a model alias and an effort level that are
    # passed only when the active Agent tool schema advertises them; otherwise
    # the agent's frontmatter applies, or a generic agent inherits the parent.
    # Efforts match the Codex tiers.
    tiers:
      scout: { agent: "forgewright-scout", model: "haiku", effort: "low" }
      builder: { agent: "forgewright-builder", model: "sonnet", effort: "medium" }
      expert: { agent: "forgewright-expert", model: "opus", effort: "high" }
      planner: { agent: "forgewright-planner", model: "fable", effort: "high" }
      reviewer: { agent: "forgewright-reviewer", model: "fable", effort: "high" }
  antigravity:
    # Antigravity (agy CLI / IDE): preferences applied only when advertised by
    # the active session or `agy models` probe.
    orchestrator: "gemini-pro-orchestrator-neon"
    tiers:
      scout: { model: "gemini-3.8-flash-low", subagent_model: "flash_lite", browser_model: "flash" }
      builder: { model: "gemini-4-neon-medium", subagent_model: "inherit" }
      expert: { model: "gemini-4-neon-high", subagent_model: "pro" }
      planner: { model: "gemini-4-neon-high", subagent_model: "pro" }
      reviewer: { model: "gemini-4-neon-high", subagent_model: "pro" }
